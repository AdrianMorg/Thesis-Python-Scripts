# Treatment colours and display labels match the supplied reference figure.
COLORS = [
    "#AA4AC4",  # WT: purple
    "#00D91C",  # GFP: green
    "#B8611C",  # ΔNTD: burnt orange
    "#F18F8B",  # ΔCTD: salmon
    "#52A6F2",  # 2M: blue
    "#9E9E9E",  # 3M: grey
    "#E60073",  # FL: magenta
