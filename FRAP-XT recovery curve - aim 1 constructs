    parser.add_argument(
        "--output-dir",
        type=Path,
        default=DEFAULT_OUTPUT_DIR,
        help="Directory for the PNG and SVG outputs",
    )
    arguments = parser.parse_args()
    make_plot(arguments.input, arguments.output_dir)
